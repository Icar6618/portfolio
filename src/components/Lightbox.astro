  <!-- Lightbox Modal for Image Zooming with Gallery Navigation -->
  <div id="lightbox" class="lightbox-modal hidden fixed inset-0 z-50 bg-black/95 backdrop-blur-2xl flex items-center justify-center p-2 sm:p-6" onclick="closeLightbox()">
    <div class="relative max-w-5xl w-full flex flex-col items-center select-none" onclick="event.stopPropagation()">
      
      <!-- Top Bar: Counter & Close Button -->
      <div class="w-full flex items-center justify-between mb-3 px-1 sm:px-2">
        <div id="lightbox-counter" class="text-xs font-semibold px-3 py-1.5 rounded-full bg-white/10 text-white/95 border border-white/15 backdrop-blur-md shadow-lg flex items-center gap-1.5">
          <i data-lucide="images" class="w-3.5 h-3.5 text-pink-400"></i>
          <span id="lightbox-counter-text">1 / 5</span>
        </div>

        <div class="flex items-center gap-2">
          <!-- Keyboard Hint Badge (Desktop only) -->
          <div class="hidden md:flex items-center gap-1.5 text-[11px] text-slate-400 px-2.5 py-1 rounded-full bg-white/5 border border-white/10">
            <span data-i18n="lightbox_nav_hint">Гортати:</span>
            <kbd class="px-1.5 py-0.5 rounded bg-white/10 text-slate-200 font-mono text-[10px]">←</kbd>
            <kbd class="px-1.5 py-0.5 rounded bg-white/10 text-slate-200 font-mono text-[10px]">→</kbd>
          </div>

          <!-- Close Button -->
          <button onclick="closeLightbox()" aria-label="Закрити" class="text-white/80 hover:text-white p-2 rounded-full bg-white/10 hover:bg-white/20 border border-white/10 transition-all z-10 cursor-pointer shadow-lg active:scale-95">
            <i data-lucide="x" class="w-5 h-5 sm:w-6 sm:h-6"></i>
          </button>
        </div>
      </div>

      <!-- Main Viewer Area with Image and Navigation Controls -->
      <div class="relative w-full flex items-center justify-center">
        <!-- Prev Button -->
        <button id="lightbox-prev" onclick="lightboxPrev(event)" aria-label="Попереднє фото" class="absolute left-1 sm:-left-14 md:-left-16 top-1/2 -translate-y-1/2 w-11 h-11 sm:w-13 sm:h-13 rounded-full bg-black/70 hover:bg-purple-600/90 active:scale-90 border border-white/20 text-white flex items-center justify-center transition-all shadow-2xl hover:scale-110 z-30 cursor-pointer backdrop-blur-xl group" title="Попереднє (←)">
          <i data-lucide="chevron-left" class="w-6 h-6 group-hover:-translate-x-0.5 transition-transform"></i>
        </button>

        <!-- Image Container with Zoom -->
        <div id="lightbox-zoom-box" class="relative overflow-hidden rounded-2xl border border-white/15 bg-black/50 shadow-2xl flex items-center justify-center max-w-full max-h-[76vh] sm:max-h-[80vh] cursor-zoom-in select-none">
          <img id="lightbox-img" src="" alt="Enlarged preview" class="max-w-full max-h-[74vh] sm:max-h-[78vh] object-contain select-none pointer-events-none transition-all duration-150 ease-out will-change-transform">
          <div id="zoom-hint-badge" class="absolute bottom-3 right-3 px-3 py-1.5 rounded-full bg-black/80 backdrop-blur-md border border-white/20 text-[11px] text-white/90 font-medium flex items-center gap-1.5 pointer-events-none transition-all duration-200 shadow-lg">
            <i id="zoom-hint-icon" data-lucide="zoom-in" class="w-3.5 h-3.5 text-pink-400"></i>
            <span id="zoom-hint-text" data-i18n="lightbox_zoom_hint">Натисніть для збільшення 🔍</span>
          </div>
        </div>

        <!-- Next Button -->
        <button id="lightbox-next" onclick="lightboxNext(event)" aria-label="Наступне фото" class="absolute right-1 sm:-right-14 md:-right-16 top-1/2 -translate-y-1/2 w-11 h-11 sm:w-13 sm:h-13 rounded-full bg-black/70 hover:bg-purple-600/90 active:scale-90 border border-white/20 text-white flex items-center justify-center transition-all shadow-2xl hover:scale-110 z-30 cursor-pointer backdrop-blur-xl group" title="Наступне (→)">
          <i data-lucide="chevron-right" class="w-6 h-6 group-hover:translate-x-0.5 transition-transform"></i>
        </button>
      </div>

      <!-- Caption -->
      <div id="lightbox-caption" class="text-xs sm:text-sm text-slate-200 mt-3.5 text-center font-medium max-w-2xl px-4 min-h-[1.5rem]"></div>

      <!-- Dots Indicator (Clickable pagination dots for sets <= 12 items) -->
      <div id="lightbox-dots" class="flex items-center justify-center gap-1.5 mt-2"></div>
    </div>
  </div>

