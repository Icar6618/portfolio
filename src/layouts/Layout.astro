---
import '../styles/global.css';
import { translations } from '../i18n/translations.js';
import { defaultLang, languages, langPath, meta, siteBase } from '../i18n/config.js';

// Page language comes from the URL (Astro i18n routing): / → uk, /en/ → en, /ru/ → ru
const lang = (Astro.currentLocale && languages.includes(Astro.currentLocale)) ? Astro.currentLocale : defaultLang;
const m = meta[lang];

// Absolute URLs (required by Open Graph / Twitter / hreflang); built from `site` + `base` in astro.config.mjs
const baseUrl = new URL(siteBase, Astro.site);
const pageUrl = (l: string) => new URL(langPath(l), baseUrl).href;
const canonicalUrl = pageUrl(lang);
const imageUrl = new URL(m.image, baseUrl).href;

// Only the current language's strings are shipped to the browser
const i18n = translations[lang];
---

<!DOCTYPE html>
<html lang={m.htmlLang} data-base={siteBase} class="scroll-smooth">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title id="page-title">{m.title}</title>

  <!-- SEO -->
  <meta name="description" content={m.description}>
  <meta name="author" content={m.author}>
  <meta name="keywords" content={m.keywords}>
  <meta name="robots" content="index, follow, max-image-preview:large">
  <meta name="theme-color" content="#07090E">
  <meta name="color-scheme" content="dark light">
  <link rel="canonical" href={canonicalUrl}>
  {languages.map((l) => <link rel="alternate" hreflang={meta[l].htmlLang} href={pageUrl(l)}>)}
  <link rel="alternate" hreflang="x-default" href={pageUrl(defaultLang)}>

  <!-- Open Graph -->
  <meta property="og:type" content="website">
  <meta property="og:site_name" content={m.siteName}>
  <meta property="og:title" content={m.title}>
  <meta property="og:description" content={m.description}>
  <meta property="og:url" content={canonicalUrl}>
  <meta property="og:image" content={imageUrl}>
  <meta property="og:image:type" content="image/jpeg">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:image:alt" content={m.imageAlt}>
  <meta property="og:locale" content={m.ogLocale}>
  {languages.filter((l) => l !== lang).map((l) => <meta property="og:locale:alternate" content={meta[l].ogLocale}>)}

  <!-- Twitter / X -->
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content={m.title}>
  <meta name="twitter:description" content={m.description}>
  <meta name="twitter:image" content={imageUrl}>
  <meta name="twitter:image:alt" content={m.imageAlt}>

  <!-- Icons -->
  <link rel="icon" type="image/png" sizes="64x64" href="favicon.png">
  <link rel="apple-touch-icon" href="apple-touch-icon.png">

  <!-- Performance: early connections, fonts and LCP image -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="dns-prefetch" href="https://unpkg.com">
  <link rel="preload" as="image" href="assets/avatar.webp" fetchpriority="high">
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=Space+Grotesk:wght@500;700&display=swap">

  <!-- UI strings for this page's language (used by js/portfolio.js) -->
  <script is:inline define:vars={{ i18n, lang }}>window.__I18N__ = { [lang]: i18n };</script>

  <!-- Tailwind CSS is compiled at build time (tailwind.config.mjs → src/styles/global.css) -->
  <!-- Lucide Icons (deferred; icons are created on DOMContentLoaded) -->
  <script is:inline defer src="https://unpkg.com/lucide@latest"></script>

  <!-- Immediate Theme Loader to avoid FOUC -->
  <script is:inline>
    (function() {
      const full = localStorage.getItem('preferred_full_theme');
      const simple = localStorage.getItem('preferred_theme');
      const theme = full || (simple === 'light' ? 'midnight-light' : 'midnight-dark');
      const el = document.documentElement;
      el.classList.remove('dark', 'light', 'theme-midnight', 'theme-blue', 'theme-fire', 'theme-green');
      if (theme.startsWith('blue')) {
        el.classList.add('theme-blue');
      } else if (theme.startsWith('fire')) {
        el.classList.add('theme-fire');
      } else if (theme.startsWith('green')) {
        el.classList.add('theme-green');
      } else {
        el.classList.add('theme-midnight');
      }
      if (theme.includes('light')) {
        el.classList.add('light');
      } else {
        el.classList.add('dark');
      }
    })();
  </script>
</head>
<body class="min-h-screen">
  <slot />
  
  <!-- Portfolio Interactive Client Scripts -->
  <script is:inline defer src="js/portfolio.js"></script>
</body>
</html>
